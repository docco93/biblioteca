# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NUNCA deve ser commitado no Git (já está no .gitignore).

# Gere uma chave própria, por exemplo rodando:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-gerada-so-para-o-seu-projeto

# Nunca deixe True em produção
DJANGO_DEBUG=True

# Em produção, liste os domínios/IPs separados por vírgula, ex:
#   DJANGO_ALLOWED_HOSTS=meudominio.com,www.meudominio.com
DJANGO_ALLOWED_HOSTS=*
